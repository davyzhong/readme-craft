{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davyzhong/readme-craft/rules.schema.json",
  "title": "readme-craft 规则规范（rules.yaml）",
  "type": "object",
  "required": ["version", "rules", "antiPatterns"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
      "description": "规范版本；必须与 SKILL frontmatter 及 package.json version 一致（P9）"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "antiPatterns": {
      "type": "array",
      "items": { "$ref": "#/$defs/antiPattern" }
    }
  },
  "$defs": {
    "projectType": {
      "type": "string",
      "enum": ["cli", "library", "desktop", "web-app", "service", "knowledge-base"]
    },
    "evaluator": {
      "type": "string",
      "enum": ["deterministic", "agent-reviewed"]
    },
    "axis": {
      "type": "string",
      "enum": ["structure", "content", "visual", "ai", "inclusive"]
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "title",
        "axis",
        "applies_to",
        "intent",
        "scores",
        "evidence",
        "evaluator",
        "thresholds"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T(0[1-9]|1[0-9])$",
          "description": "规范内部 ID，零填充 T01..T19；散文写法 T1..T19 由 generate 映射"
        },
        "title": { "type": "string", "minLength": 1 },
        "axis": { "$ref": "#/$defs/axis" },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/projectType" }
        },
        "intent": { "type": "string", "minLength": 1 },
        "scores": {
          "type": "object",
          "required": ["0", "1", "2", "3", "4", "5"],
          "additionalProperties": false,
          "properties": {
            "0": { "type": "string", "minLength": 1 },
            "1": { "type": "string", "minLength": 1 },
            "2": { "type": "string", "minLength": 1 },
            "3": { "type": "string", "minLength": 1 },
            "4": { "type": "string", "minLength": 1 },
            "5": { "type": "string", "minLength": 1 }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evaluator": { "$ref": "#/$defs/evaluator" },
        "browser_safe": {
          "type": "boolean",
          "description": "是否可在浏览器中运行（仅依赖 Markdown 字符串）；deterministic 规则必须声明，agent-reviewed 不得为 true"
        },
        "thresholds": {
          "type": "object",
          "required": ["partial", "pass"],
          "additionalProperties": false,
          "properties": {
            "partial": { "type": "integer", "minimum": 0, "maximum": 5 },
            "pass": { "type": "integer", "minimum": 0, "maximum": 5 }
          }
        }
      }
    },
    "antiPattern": {
      "type": "object",
      "required": ["id", "title", "maps_to"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A(0[1-9]|1[0-3])$"
        },
        "title": { "type": "string", "minLength": 1 },
        "maps_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^T(0[1-9]|1[0-9])$" }
        }
      }
    }
  }
}
